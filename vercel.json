{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist-web",
  "functions": {
    "api/index.ts": {
      "includeFiles": "demo-app/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
