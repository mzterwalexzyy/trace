# TRACE environment configuration
# Copy this file to `.env` (or set these in your host's env / Vercel project)
# and fill in real values. TRACE runs fully in LOCAL mode with none of these set.
# Never commit real secrets — this file must only ever contain placeholders.

# --- HydraDB Cloud (optional) ---
# Get an API key from https://dashboard.hydradb.com
# When HYDRA_DB_API_KEY is present, TRACE uses HydraDB Cloud for context
# ingestion and retrieval. Without it, TRACE stays in local mode.
HYDRA_DB_API_KEY=
# The HydraDB database (tenant) to read from and write to.
HYDRA_DB_DATABASE=default

# --- TRACE runtime ---
# Force a storage mode regardless of the key: "local" or "cloud".
# Leave unset to auto-select (cloud when a key is present, otherwise local).
# TRACE_MODE=
# Port for the TRACE web/API server (defaults to 3000).
# PORT=3000

# --- GitHub (optional) ---
# Analyzing public repos by URL fetches their source tarball from the GitHub API.
# A token (a fine-grained token with public read access is enough) raises the
# rate limit from 60 to 5000 requests/hour. Used read-only; leave unset to use
# unauthenticated requests. GH_TOKEN is accepted as an alias.
# GITHUB_TOKEN=

# --- Supabase backend (optional — multi-user persistence) ---
# When set, TRACE mirrors each analysis (repo, run, graph) to Supabase for the
# signed-in user. Without them, TRACE persists locally to .trace/ as before.
# From your Supabase project: Settings → API.
SUPABASE_URL=
# SERVER ONLY — the service_role key bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (browser/frontend) ---
# The anon/public key + URL are safe to expose to the browser (RLS protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Ask TRACE AI provider (optional) ---
# Ask TRACE works WITHOUT any AI key (deterministic Evidence Mode). If a key is
# present, the AI only *explains* TRACE's evidence — it never invents facts.
# Standard providers (checked first):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRACE_AI_MODEL=
#
# Or an OpenAI-compatible gateway (primary, with a fallback model on error):
API_KEY=
Main_Base_URL=
Main_Models=
Fall_Back_Model=
# Or an alternate OpenAI-compatible gateway:
ALT_API_KEY=
Base_URL=
Model=
